TELEGRAM_BOT_TOKEN=ضع_توكن_البوت_هنا
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

BINANCE_BASE_URL=https://fapi.binance.com

PORT=8080
TZ=Asia/Riyadh
LOG_LEVEL=INFO

SCAN_SECONDS=15
MAX_CONCURRENCY=16
RADAR_POOL=180
DEEP_CANDIDATES=60
MIN_QUOTE_VOLUME_USDT=750000
MAX_ALERTS_PER_SCAN=2
TELEGRAM_MIN_INTERVAL_SECONDS=2.5

DELTA_SOURCE_1H=5m
DELTA_SOURCE_4H=15m

NORMAL_1H_CONFIRM_BARS=3
FAST_1H_CONFIRM_BARS=2
NORMAL_4H_CONFIRM_BARS=2
FAST_4H_CONFIRM_BARS=1

ABNORMAL_LOOKBACK=20
ABNORMAL_BODY_PERCENTILE=0.80
ABNORMAL_VOLUME_PERCENTILE=0.75
ABNORMAL_RANGE_PERCENTILE=0.80
ABNORMAL_CLOSE_LOCATION=0.68
ABNORMAL_MIN_COMPONENTS=2

BIG_CANDLE_BODY_ATR=0.65
BIG_CANDLE_VOLUME_MULT=1.40

VERY_BIG_CANDLE_BODY_ATR=0.90
VERY_BIG_CANDLE_VOLUME_MULT=1.80

ABNORMAL_RELATIVE_FILTER=true
REQUIRE_FIXED_ABNORMAL_FILTER=true

NORMAL_MIN_DELTA_PCT=8
NORMAL_MIN_DIRECTIONAL_BARS=2
FAST_MIN_DELTA_PCT=18
MIN_DELTA_SLOPE=2.0

MIN_SIGNAL_SCORE=52
MIN_DIRECTION_GAP=8

MAX_1H_SIGNAL_EXTENSION_ATR=0.45
MAX_4H_SIGNAL_EXTENSION_ATR=0.60
MAX_1H_AGE_MINUTES=30
MAX_4H_AGE_MINUTES=120

REQUIRE_LAST_CANDLE_DIRECTION=true
MAX_OPPOSITE_CANDLE_DELTA_PCT=12
ALLOW_SMALL_OPPOSITE_CANDLE=true
MAX_SMALL_OPPOSITE_BODY_ATR=0.25

ENABLE_4H_1H_CONFLICT_FILTER=true
LOWER_TF_STRONG_SCORE=80
CONFLICT_WARN_FACTORS=2
CONFLICT_BLOCK_FACTORS=4
CONFLICT_SCORE_PENALTY=8
BOS_LOOKBACK=12
LIQUIDITY_SCORE_MIN=50

STOP_ATR_MULT=0.90
TP1_R=1.0
TP2_R=2.0
TP3_R=3.0

DELTA_LEN=14
DELTA_MULT=2.0
DELTA_MIN_VOL=1.10

COOLDOWN_MINUTES=90

BINANCE_RETRIES=4
SYMBOL_TIMEOUT=15
SCAN_TIMEOUT=60
EXCHANGE_CACHE_SECONDS=3600
PRICE_CACHE_SECONDS=30

SEND_STARTUP_MESSAGE=true
SEND_TEST_MESSAGE=true
ENABLE_MANUAL_TEST_ENDPOINT=true

DB_PATH=data/delta_early_predictor.db
